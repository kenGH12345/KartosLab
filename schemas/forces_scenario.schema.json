{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kartos/forces-scenario.schema.json",
  "title": "Forces Scenario",
  "type": "object",
  "required": [
    "scenarioId",
    "name",
    "mode"
  ],
  "properties": {
    "inquiryTask": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "instruction"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "instruction": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "snapshotColumns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "source"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "param",
                  "reading"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "referenceConclusion": {
          "type": "string"
        },
        "predictions": {
          "type": "array",
          "description": "先猜后验预测题。对应探究五阶段的「猜测」阶段——缺省或空数组时该阶段自动跳过，学生直接进入「任务」阶段。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "options",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "description": "选项文本列表，通常 2-4 项"
              },
              "answer": {
                "type": "integer",
                "minimum": 0,
                "description": "正确选项在 options 中的下标（0 基）"
              },
              "explanation": {
                "type": "string",
                "description": "验证后展示的原理解析（建议填写，学生答错时是关键反馈）"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scenarioId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "netForce",
        "motion",
        "friction",
        "acceleration"
      ]
    },
    "initialParams": {
      "type": "object",
      "properties": {
        "mass": {
          "type": "number",
          "default": 50,
          "description": "kg"
        },
        "position": {
          "type": "number",
          "default": 0,
          "description": "m"
        },
        "velocity": {
          "type": "number",
          "default": 0,
          "description": "m/s"
        },
        "appliedForce": {
          "type": "number",
          "default": 0,
          "description": "N, range -500~500"
        },
        "frictionCoeff": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 0.5
        },
        "showAccelerometer": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "gameRules": {
      "type": "object",
      "properties": {
        "gameLength": {
          "type": "number",
          "default": 400
        },
        "cartStep": {
          "type": "number",
          "default": 0.003
        }
      },
      "additionalProperties": false
    },
    "pullers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "force",
          "side",
          "color"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "force": {
            "type": "number",
            "enum": [
              50,
              100,
              150
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "color": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{8}$"
          }
        },
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "mass",
          "icon"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "mass": {
            "type": "number",
            "minimum": 1
          },
          "icon": {
            "type": "string",
            "description": "Material icon name"
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "maxSpeed",
              "maxObjects",
              "forceRange"
            ]
          },
          "description": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/criterion"
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trigger",
          "message"
        ],
        "properties": {
          "trigger": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "criterion": {
      "description": "叶子或组合条件。组合算子 all/any/not 可嵌套（解析端深度上限 4 层）。",
      "oneOf": [
        { "$ref": "#/definitions/criterionLeaf" },
        { "$ref": "#/definitions/criterionAll" },
        { "$ref": "#/definitions/criterionAny" },
        { "$ref": "#/definitions/criterionNot" }
      ]
    },
    "criterionLeaf": {
      "type": "object",
      "required": [
        "id",
        "type",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "speedReached",
            "forceBalanced",
            "positionReached",
            "gameWon"
          ]
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "criterionAll": {
      "type": "object",
      "required": ["all"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/criterion" }
        }
      },
      "additionalProperties": false
    },
    "criterionAny": {
      "type": "object",
      "required": ["any"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/criterion" }
        }
      },
      "additionalProperties": false
    },
    "criterionNot": {
      "type": "object",
      "required": ["not"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "not": { "$ref": "#/definitions/criterion" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
