{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kartos/radio-waves-scenario.schema.json",
  "title": "Radio Waves Scenario",
  "type": "object",
  "required": [
    "scenarioId",
    "name",
    "screen"
  ],
  "properties": {
    "inquiryTask": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "instruction"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "instruction": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "snapshotColumns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "source"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "param",
                  "reading"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "referenceConclusion": {
          "type": "string"
        },
        "predictions": {
          "type": "array",
          "description": "先猜后验预测题。对应探究五阶段的「猜测」阶段——缺省或空数组时该阶段自动跳过，学生直接进入「任务」阶段。",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "options",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "question": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "description": "选项文本列表，通常 2-4 项"
              },
              "answer": {
                "type": "integer",
                "minimum": 0,
                "description": "正确选项在 options 中的下标（0 基）"
              },
              "explanation": {
                "type": "string",
                "description": "验证后展示的原理解析（建议填写，学生答错时是关键反馈）"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scenarioId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "screen": {
      "type": "string",
      "enum": [
        "singleAntenna"
      ],
      "description": "singleAntenna = one transmitting antenna with oscillating electron, field arrows, and wave curve"
    },
    "initialParams": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 2.0,
          "default": 0.5,
          "description": "Electron oscillation speed. Higher = faster oscillation, shorter wavelength (denser wave crests)."
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "Electron oscillation amplitude [0,1]. 0 = no movement, 1 = maximum displacement."
        },
        "showCurve": {
          "type": "boolean",
          "default": true,
          "description": "Display the red envelope curve connecting field arrow tips."
        },
        "showArrows": {
          "type": "boolean",
          "default": true,
          "description": "Display green field strength arrows along the X-axis."
        },
        "dynamicFieldEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable propagating dynamic field (radiation). When false, only shows static Coulomb field."
        }
      },
      "additionalProperties": false
    },
    "paramRanges": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "object",
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "amplitude": {
          "type": "object",
          "required": [
            "min",
            "max",
            "step"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "successCriteria": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/criterion"
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "trigger",
          "message"
        ],
        "properties": {
          "trigger": {
            "type": "string",
            "description": "'always' or a condition expression like 'frequency < 0.3'"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "criterion": {
      "description": "叶子或组合条件。组合算子 all/any/not 可嵌套（解析端深度上限 4 层）。",
      "oneOf": [
        { "$ref": "#/definitions/criterionLeaf" },
        { "$ref": "#/definitions/criterionAll" },
        { "$ref": "#/definitions/criterionAny" },
        { "$ref": "#/definitions/criterionNot" }
      ]
    },
    "criterionLeaf": {
      "type": "object",
      "required": [
        "id",
        "type",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "observeWave",
            "observeField",
            "toggleField",
            "frequencyReached",
            "amplitudeReached"
          ]
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "properties": {
            "minFrequency": { "type": "number" },
            "maxFrequency": { "type": "number" },
            "exactFrequency": { "type": "number" },
            "minAmplitude": { "type": "number" },
            "maxAmplitude": { "type": "number" },
            "exactAmplitude": { "type": "number" },
            "dynamicFieldEnabled": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "criterionAll": {
      "type": "object",
      "required": ["all"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/criterion" }
        }
      },
      "additionalProperties": false
    },
    "criterionAny": {
      "type": "object",
      "required": ["any"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/criterion" }
        }
      },
      "additionalProperties": false
    },
    "criterionNot": {
      "type": "object",
      "required": ["not"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "not": { "$ref": "#/definitions/criterion" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
