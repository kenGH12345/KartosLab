{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kratos.local/schemas/molarity_scenario.schema.json",
  "title": "Molarity Scenario",
  "description": "摩尔浓度 sim 的场景配置（对齐 lib/chemistry/molarity/config/molarity_scenario.dart）。",
  "type": "object",
  "required": ["scenarioId", "name", "initialParams"],
  "properties": {
    "scenarioId": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "initialParams": {
      "type": "object",
      "required": ["soluteIndex", "soluteAmount", "volume"],
      "properties": {
        "soluteIndex": { "type": "integer", "minimum": 0, "maximum": 8 },
        "soluteAmount": { "type": "number", "minimum": 0, "maximum": 1 },
        "volume": { "type": "number", "minimum": 0.2, "maximum": 1 },
        "valuesVisible": { "type": "boolean" }
      }
    },
    "paramRanges": {
      "type": "object",
      "properties": {
        "soluteAmount": { "$ref": "#/definitions/paramRange" },
        "volume": { "$ref": "#/definitions/paramRange" }
      }
    },
    "concentrationMax": { "type": "number", "minimum": 0 },
    "solutes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": { "$ref": "#/definitions/solute" }
    },
    "performance": {
      "type": "object",
      "properties": {
        "particlesPerMole": { "type": "integer", "minimum": 1, "maximum": 200 },
        "particleSize": { "type": "number", "minimum": 1 }
      }
    },
    "successCriteria": {
      "type": "array",
      "items": { "$ref": "#/definitions/criterion" }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "message"],
        "properties": {
          "trigger": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "inquiryTask": {
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "instruction"],
            "properties": {
              "id": { "type": "string" },
              "instruction": { "type": "string" },
              "hint": { "type": "string" }
            }
          }
        },
        "snapshotColumns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "label", "source"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "source": { "enum": ["param", "reading"] }
            }
          }
        },
        "referenceConclusion": { "type": "string" }
      }
    }
  },
  "definitions": {
    "paramRange": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "solute": {
      "type": "object",
      "required": ["name", "formula", "saturatedConcentration", "solutionColorMin", "solutionColorMax", "particleColor"],
      "properties": {
        "name": { "type": "string" },
        "formula": { "type": "string" },
        "saturatedConcentration": { "type": "number", "minimum": 0 },
        "solutionColorMin": { "$ref": "#/definitions/hexColor" },
        "solutionColorMax": { "$ref": "#/definitions/hexColor" },
        "particleColor": { "$ref": "#/definitions/hexColor" },
        "particleSize": { "type": "number" },
        "particlesPerMole": { "type": "integer" }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "type", "description"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "enum": ["solutionSaturated", "concentrationReached", "precipitateVisible", "soluteChanged"]
        },
        "description": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
