        "type": "bulbBrightness",
        "description": "灯泡正常发光",
        "params": {
          "minBrightness": 0.01
        }
      }
    ],
    "hints": [
      {
        "trigger": "openNodes > 0",
        "message": "电路还未闭合！请从灯泡右端拖一根导线，绕回电池左端"
