{
  "scenarioId": "simple-series",
  "name": "简单串联电路",
  "description": "1 电池 + 1 电阻 + 1 灯泡 串联闭合回路 · Step 1a 演示非空拓扑加载",
  "version": "1.0",

  "inventory": {
    "availableComponents": {
      "battery":    { "maxCount": 2, "locked": false, "defaultParams": { "value": 10.0 } },
      "resistor":   { "maxCount": 2, "locked": false, "defaultParams": { "value": 10.0 } },
      "lightBulb":  { "maxCount": 2, "locked": false, "defaultParams": { "value": 10.0 } },
      "switch_":    { "maxCount": 1, "locked": false, "defaultParams": {} },
      "fuse":       { "maxCount": 1, "locked": false, "defaultParams": {} },
      "ground":     { "maxCount": 1, "locked": false, "defaultParams": {} },
      "wire":       { "maxCount": 10, "locked": false, "defaultParams": {} }
    }
  },

  "initialLayout": {
    "vertices": [
      { "id": "v_bat_l",   "x": 100.0, "y": 200.0, "isTerminal": true  },
      { "id": "v_bat_r",   "x": 220.0, "y": 200.0, "isTerminal": true  },
      { "id": "v_res_l",   "x": 340.0, "y": 200.0, "isTerminal": true  },
      { "id": "v_res_r",   "x": 460.0, "y": 200.0, "isTerminal": true  },
      { "id": "v_bulb_l",  "x": 580.0, "y": 200.0, "isTerminal": true  },
      { "id": "v_bulb_r",  "x": 700.0, "y": 200.0, "isTerminal": true  }
    ],
    "components": [
      {
        "id": "bat_1",
        "type": "battery",
        "x": 160.0, "y": 200.0,
        "value": 10.0,
        "startVertexId": "v_bat_l",
        "endVertexId":   "v_bat_r"
      },
      {
        "id": "res_1",
        "type": "resistor",
        "x": 400.0, "y": 200.0,
        "value": 10.0,
        "startVertexId": "v_res_l",
        "endVertexId":   "v_res_r"
      },
      {
        "id": "bulb_1",
        "type": "lightBulb",
        "x": 640.0, "y": 200.0,
        "value": 10.0,
        "startVertexId": "v_bulb_l",
        "endVertexId":   "v_bulb_r"
      }
    ],
    "wires": [
      {
        "id": "w1",
        "startVertexId": "v_bat_r",
        "endVertexId":   "v_res_l"
      },
      {
        "id": "w2",
        "startVertexId": "v_res_r",
        "endVertexId":   "v_bulb_l"
      },
      {
        "id": "w3",
        "startVertexId": "v_bulb_r",
        "endVertexId":   "v_bat_l",
        "controlPoints": [
          { "x": 760.0, "y": 350.0 },
          { "x":  40.0, "y": 350.0 }
        ]
      }
    ]
  },

  "constraints": [
    {
      "id": "c1",
      "type": "topology",
      "description": "电路必须形成闭合回路",
      "params": { "requireClosed": true },
      "enforced": true
    },
    {
      "id": "c2",
      "type": "componentCount",
      "description": "至少需要一个电池",
      "params": { "componentType": "battery", "minCount": 1 },
      "enforced": false
    }
  ],

  "objectives": {
    "type": "guided",
    "description": "搭建一个简单串联电路，让灯泡发光",
    "successCriteria": [
      {
        "id": "sc-1",
        "type": "circuitClosed",
        "description": "电路形成闭合回路",
        "params": {}
      },
      {
        "id": "sc-2",
        "type": "bulbBrightness",
        "description": "灯泡亮度 > 0",
        "params": { "minBrightness": 0.01 }
      }
    ],
    "hints": [
      { "trigger": "openNodes > 0", "message": "电路还未闭合，请用导线连接所有元件" },
      { "trigger": "no_battery", "message": "请添加一个电池为电路供电" }
    ],
    "validation": { "autoCheck": true, "showFeedback": true }
  },

  "inquiryTask": {
    "question": "保持电池电压不变，改变电阻大小，观察电流和灯泡亮度的变化，你能发现什么规律？",
    "steps": [
      {
        "id": "step-1",
        "instruction": "选中电阻，用下方滑块将阻值从 5Ω 逐步调到 50Ω（至少 5 个档位），每次调整后点击「记录本次实验」。",
        "hint": "保持电池电压 10V 不变，一次只改电阻"
      },
      {
        "id": "step-2",
        "instruction": "观察实验记录表，电流与电阻之间是什么关系？"
      }
    ],
    "referenceConclusion": "电压不变时，电路中的电流与电阻成反比（I = V / R，欧姆定律）：电阻越大，电流越小，灯泡亮度也随之降低。",
    "snapshotColumns": [
      { "key": "resistance", "label": "电阻(Ω)", "source": "param" },
      { "key": "current", "label": "电流(A)", "source": "reading" },
      { "key": "voltage", "label": "电阻端电压(V)", "source": "reading" },
      { "key": "brightness", "label": "灯泡亮度", "source": "reading" }
    ]
  }
}
