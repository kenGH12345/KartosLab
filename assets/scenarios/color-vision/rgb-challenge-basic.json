  "inquiryTask": {
    "question": "挑战开始前想一想：要调出黄色，应该同时打开哪两盏灯？",
    "steps": [
      {
        "id": "step-1",
        "instruction": "观察右上角的目标色，调整 R/G/B 滑块向它靠近。"
      },
      {
        "id": "step-2",
        "instruction": "匹配度达到阈值即挑战成功；观察每关目标色的规律，思考加色法原理。"
      }
    ],
    "referenceConclusion": "黄=红+绿、青=绿+蓝、品红=红+蓝。挑战中的每个目标色都能拆成两种原色光的组合——这就是加色法的应用。"
  }
}
