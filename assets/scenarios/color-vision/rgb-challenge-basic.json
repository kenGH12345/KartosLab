{
  "scenarioId": "rgb-challenge-basic",
  "name": "颜色匹配挑战 · 初级",
  "description": "按目标色调整 RGB 滑块，在倒计时内精确匹配颜色。目标色与难度由配置驱动。",
  "version": "1.0",
  "screen": "rgb",
  "initialParams": {
    "redIntensity": 0,
    "greenIntensity": 0,
    "blueIntensity": 0,
    "personPosition": 300
  },
  "challenge": {
    "enabled": true,
    "mode": "colorMatch",
    "difficulty": "easy",
    "timeLimit": 30,
    "timeBonusPerLevel": 5,
    "accuracyThreshold": 95.0,
    "targets": [
      { "color": "#FFFF00", "label": "黄色（红+绿）" },
      { "color": "#00FFFF", "label": "青色（绿+蓝）" },
      { "color": "#FF00FF", "label": "品红（红+蓝）" }
    ],
    "randomTargets": { "enabled": true, "count": 5, "excludeGrayscale": true }
  },
  "successCriteria": [
    { "id": "sc-1", "type": "colorMatch", "description": "匹配出黄色", "params": {"targetColor": "yellow", "tolerance": 30} }
