{
  "scenarioId": "motion-explore",
  "name": "力与运动探索",
  "description": "无摩擦平面 · 堆叠不同质量的箱子，施加推力观察速度变化 · 演示 F=ma：相同力下质量越大加速度越小",
  "version": "1.0",
  "mode": "motion",
  "initialParams": {
    "mass": 10,
    "position": 0,
    "velocity": 0,
    "appliedForce": 100,
    "frictionCoeff": 0
  },
  "objects": [
    {
      "id": "box_10",
      "label": "小箱 (10kg)",
      "mass": 10,
      "icon": "inventory_2"
    },
    {
      "id": "box_20",
      "label": "中箱 (20kg)",
      "mass": 20,
      "icon": "inventory_2"
    },
    {
      "id": "box_50",
      "label": "大箱 (50kg)",
      "mass": 50,
      "icon": "warehouse"
    },
    {
      "id": "crate_100",
      "label": "货箱 (100kg)",
      "mass": 100,
      "icon": "cases"
    }
  ],
  "successCriteria": [
    {
      "id": "sc-1",
      "type": "speedReached",
      "description": "使物体加速到 10 m/s",
      "params": {
        "minSpeed": 10
      }
    }
  ],
  "constraints": [
    {
      "id": "c1",
      "type": "maxSpeed",
      "description": "最大速度不超过 40 m/s",
      "params": {
        "maxSpeed": 40
      }
    },
    {
      "id": "c2",
      "type": "maxObjects",
      "description": "最多堆叠 3 个物体",
      "params": {
        "maxObjects": 3
      }
    }
  ],
  "hints": [
    {
      "trigger": "speed < 2",
      "message": "试试增加施加力（滑块向右推）"
    },
    {
      "trigger": "always",
      "message": "增加质量会让加速度变小——验证 F=ma！"
    }
  ],
  "inquiryTask": {
    "question": "保持施加力不变，改变物体的总质量，观察加速度的变化，你能发现 F 与 m、a 的关系吗？",
    "steps": [
      {
        "id": "step-1",
        "instruction": "只放 1 个小箱（10kg），施加力拉到 100N，开始运行并记录。",
        "hint": "加速度 = 合力 ÷ 质量"
      },
      {
        "id": "step-2",
        "instruction": "再叠上中箱（总质量 30kg），同样的力再运行一次并记录。",
        "hint": "保持施加力不变，只改变质量"
      },
      {
        "id": "step-3",
        "instruction": "对比两次加速度，归纳质量与加速度的关系。"
      }
    ],
    "referenceConclusion": "力相同时，质量越大加速度越小——a = F / m（牛顿第二定律）。要获得更大的加速度，要么增大推力，要么减小质量。",
    "snapshotColumns": [
      { "key": "appliedForce", "label": "施加力(N)", "source": "param" },
      { "key": "mass", "label": "总质量(kg)", "source": "param" },
      { "key": "acceleration", "label": "加速度(m/s²)", "source": "reading" },
      { "key": "speed", "label": "速度(m/s)", "source": "reading" }
    ]
  }
}