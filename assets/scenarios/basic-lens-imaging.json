{
  "scenarioId": "basic-lens-imaging",
  "name": "凸透镜成像规律",
  "description": "探究凸透镜成像的特点和规律",
  "version": "1.0.0",
  "level": "beginner",
  "domain": "optics-lens",

  "inventory": {
    "availableComponents": {
      "lightSource": {
        "maxCount": 1,
        "locked": false,
        "defaultParams": { "sourceType": "object", "objectHeight": 5.0 }
      },
      "lens": {
        "maxCount": 2,
        "locked": false,
        "defaultParams": { "lensType": "convex", "focalLength": 10.0, "diameter": 5.0 }
      },
      "screen": {
        "maxCount": 1,
        "locked": false,
        "defaultParams": {}
      }
    }
  },

  "initialLayout": [
    {
      "id": "light_1",
      "type": "lightSource",
      "x": -25,
      "y": 0,
      "locked": false,
      "params": { "sourceType": "object", "objectHeight": 5.0 }
    },
    {
      "id": "lens_1",
      "type": "lens",
      "x": 0,
      "y": 0,
      "locked": false,
      "params": { "lensType": "convex", "focalLength": 10.0, "diameter": 20.0 }
    },
    {
      "id": "screen_1",
      "type": "screen",
      "x": 16,
      "y": 0,
      "locked": false,
      "params": {}
    }
  ],

  "constraints": [
    {
      "id": "c1",
      "type": "alignment",
      "description": "蜡烛、透镜、光屏对齐在同一水平线",
      "params": { "elementIds": ["light_1", "lens_1", "screen_1"], "axis": "y", "tolerance": 5 },
      "enforced": false
    }
  ],

  "objectives": {
    "type": "guided",
    "description": "观察凸透镜成像的三种情况：放大倒立、缩小倒立、无法成像（f = 焦距，2f = 二倍焦距）",
    "successCriteria": [
      {
        "id": "sc-1",
        "type": "imageProperties",
        "description": "当物距 u > 2f（二倍焦距）时，成缩小倒立的实像",
        "params": {}
      }
    ],
    "hints": [
      { "trigger": "objectDistance > 200", "message": "试着移动光屏，找到最清晰的像" },
      { "trigger": "time_elapsed", "message": "焦距不是固定的：f = ±R / (2·(n−1))，其中 R 是曲率半径、n 是折射率，凸透镜 f 取正、凹透镜取负" },
      { "trigger": "time_elapsed", "message": "试着拖动右下角的 R 和 n 滑块：R 越大 f 越大；n 越大 f 反而越小；切换凸/凹会让 f 变号" }
    ],
    "validation": { "autoCheck": true, "showFeedback": true }
  },

  "gameRules": { "enabled": false, "penalties": [] },

  "inquiryTask": {
    "question": "移动蜡烛（物体）与透镜的距离，观察光屏上像的大小和正倒变化，凸透镜成像有什么规律？",
    "steps": [
      {
        "id": "step-1",
        "instruction": "把物体放在透镜左侧很远（物距 > 2f），拖动光屏找到清晰的像，点击「记录本次实验」。",
        "hint": "此时像是放大还是缩小？正立还是倒立？"
      },
      {
        "id": "step-2",
        "instruction": "把物体移到 2f 与 f 之间，再次找像并记录。",
        "hint": "注意像的大小发生了变化"
      },
      {
        "id": "step-3",
        "instruction": "对比两次记录，归纳像的大小与物距的关系。"
      }
    ],
    "referenceConclusion": "凸透镜成像规律：物距 u > 2f 时成缩小倒立实像；2f > u > f 时成放大倒立实像；u < f 时成正立放大虚像。物距越小（大于 f 时），像越大。",
    "snapshotColumns": [
      { "key": "objectDistance", "label": "物距", "source": "param" },
      { "key": "imageDistance", "label": "像距", "source": "reading" },
      { "key": "magnification", "label": "放大率", "source": "reading" },
      { "key": "isVirtual", "label": "虚像?", "source": "reading" }
    ]
  },

  "ui": {
    "showGrid": true,
    "showRuler": true,
    "showFocalPoints": true,
    "allowAddComponent": true,
    "allowRemoveComponent": true,
    "allowMoveComponent": true
  }
}
